# Copy to .env. Where the cost and alarm emails go (comma-separated for several).
ALERT_EMAIL=
# The monthly budget the cost emails fire against, in USD.
BUDGET_USD=10
# The Vercel team and project whose functions may use the tables.
VERCEL_TEAM=
VERCEL_PROJECT=trade-wars
# existing when the account already trusts oidc.vercel.com/<team> (one provider per account), new to make it.
VERCEL_OIDC_PROVIDER=new
