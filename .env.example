# Copy to .env.local. Everything is optional: with nothing set, Boltergeist plays on paper with Strike's mainnet prices.

# mainnet or testnet: whose prices, and where live calls go.
NEXT_PUBLIC_STRIKE_NETWORK=mainnet

# Your Strike builder code (app.strikefinance.org/builder-codes). With one, players can connect an
# Ethereum, Solana or Cardano wallet and play live. Without one, they can still connect an API key.
NEXT_PUBLIC_BUILDER_CODE=

# The builder fee on live trades, in basis points (0 to 100). Players approve it when they connect.
NEXT_PUBLIC_BUILDER_FEE_BPS=0

# Where players deposit: Strike's app for the network above.
NEXT_PUBLIC_STRIKE_APP_URL=https://app.strikefinance.org

# The arena's DynamoDB table (infra/). Without one every fight is you and nine bots.
ARENAS_TABLE=
# AWS access. On Vercel, AWS_ROLE_ARN, assumed with the deployment's OIDC token. Locally, a profile.
# AWS_ROLE_ARN=
# AWS_PROFILE=
# Or DynamoDB Local instead of AWS (docker run -p 8000:8000 amazon/dynamodb-local).
# DYNAMODB_ENDPOINT=http://localhost:8000
